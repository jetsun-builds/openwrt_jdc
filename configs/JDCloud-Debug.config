# Temporary wireless diagnostics for the JDCloud Athena RE-CS-02.
# Keep this profile separate from the normal firmware configuration.
CONFIG_VERSION_NUMBER="25.12.2-nss-debug"
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_DYNAMIC_DEBUG=y
CONFIG_KERNEL_DEBUG_INFO=y
# Keep complete DWARF type/location data in the separate symbols artifact.
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_KALLSYMS=y
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_MAC80211_TRACING=y
CONFIG_ATH11K_DEBUGFS_STA=y
CONFIG_ATH11K_DEBUGFS_HTT_STATS=y
CONFIG_PACKAGE_tcpdump-mini=y
